{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "app-asmet-ch",
	"compatibility_date": "2026-11-09",
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	"env": {
		"production": {
			"name": "app-asmet-ch",
			"routes": [
				{ "pattern": "app.asmet.ch", "custom_domain": true }
			]
		},
		"preview": {
			"name": "app-asmet-ch--preview",
			"routes": [
				{ "pattern": "preview.app.asmet.ch", "custom_domain": true }
			]
		},
		"demo": {
			"name": "app-asmet-ch--demo",
			"routes": [
				{ "pattern": "demo.app.asmet.ch", "custom_domain": true }
			]
		}
	}
}
